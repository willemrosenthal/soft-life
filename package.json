{
  "name": "softlife",
  "version": "0.1.0",
  "private": true,
  "description": "Conway's Game of Life with cells that merge into soft blobs. An installable web app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "ios": "npm run build && cap sync ios && cap open ios",
    "ios:sync": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/bricolage-grotesque": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "vanilla-colorful": "^0.7.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
